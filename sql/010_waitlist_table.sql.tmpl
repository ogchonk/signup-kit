-- signup-kit: waitlist table template (structure only); {{table}} must match ^[a-z_][a-z0-9_]{0,62}$. Idempotent; safe to re-run.
-- Safe to apply while a site's old sign-up code is still live: it adds columns, a unique index only when none exists, RLS and revokes.
-- The row checks that old code could violate are in 011, applied at that site's cutover. Source of truth: plans/2026-10-08-signup-uniform-waitlist-newsletter.md
create table if not exists public.{{table}} (
  id uuid primary key default gen_random_uuid(),
  email text not null,
  submitted_at timestamptz not null default now(),
  source text,
  user_agent text,
  referrer text
);
alter table public.{{table}} add column if not exists welcome_sent_at timestamptz;
alter table public.{{table}} add column if not exists unsubscribed_at timestamptz;
do $$ begin
  -- an existing single-column unique index on email or lower(email) is reused (ntabc: the column; pf: lower(email))
  if not exists (select 1 from pg_indexes where schemaname = 'public' and tablename = '{{table}}'
                 and indexdef ~* '^create unique index [^ ]+ on public\.{{table}} using btree \((email|lower\(email\))\)$') then
    execute 'create unique index {{table}}_email_key on public.{{table}} (lower(email))';
  end if;
end $$;
alter table public.{{table}} enable row level security;
revoke all on public.{{table}} from anon, authenticated;
