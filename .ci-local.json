{
  "version": 1,
  "merge_method": "squash",
  "jobs": [
    {
      "name": "git-diff",
      "kind": "diff_check",
      "github_checks": []
    },
    {
      "name": "test",
      "image": "node:22.21.1-bookworm@sha256:b84d52cd45bfe261096ccbf886955d431b8b9ed01b72eaef588e8886bda09e78",
      "command": "npx --yes pnpm@11.1.2 install --frozen-lockfile\nfor i in $(seq 1 60); do curl -s -o /dev/null http://postgrest:3000/ && break; sleep 1; done\ncurl -s -o /dev/null http://postgrest:3000/\nnpx --yes pnpm@11.1.2 typecheck\nnpx --yes pnpm@11.1.2 lint\nnpx --yes pnpm@11.1.2 test\nnpx --yes pnpm@11.1.2 test:db\nnpx --yes pnpm@11.1.2 build",
      "github_checks": [
        "test"
      ],
      "timeout_seconds": 1800,
      "services": [
        {
          "name": "postgres",
          "image": "postgres:16.10@sha256:21f6013073bc6b92830a2129570e2f5ec42a6c734b5a985a41e83aa58f54c3c1",
          "env": {
            "POSTGRES_PASSWORD": "t"
          }
        },
        {
          "name": "postgrest",
          "image": "postgrest/postgrest:v12.2.8@sha256:e5978740a590628f2114730bb942f35342ea70b8b7a86697a3df283c0caea109",
          "env": {
            "PGRST_DB_URI": "postgres://postgres:t@postgres:5432/postgres",
            "PGRST_DB_SCHEMAS": "public",
            "PGRST_DB_ANON_ROLE": "service_role"
          }
        }
      ],
      "env": {
        "DATABASE_URL": "postgres://postgres:t@postgres:5432/postgres",
        "POSTGREST_URL": "http://postgrest:3000"
      }
    }
  ]
}
