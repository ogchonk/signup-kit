exports[`templates > renders Next newsletter (robbychoate.com shape) 1`] = `
{
  "app/api/newsletter/confirm/route.ts": "import { createNewsletterConfirm } from "@ogchonk/signup-kit/next"
import { site } from "@/lib/signup-config"

/* Confirmation link target. GET shows a page with one button (or redirects to the site's own page);
   only the button's POST confirms, because mail scanners fetch every link. */

export const runtime = "nodejs"
export const maxDuration = 30

export const { GET, POST } = createNewsletterConfirm(site)
",
  "app/api/newsletter/route.ts": "import { createNewsletterPost } from "@ogchonk/signup-kit/next"
import { site } from "@/lib/signup-config"

/* Newsletter sign-up (double opt-in) on the shared @ogchonk/signup-kit package. The reply comes right
   after the body, honeypot, format and mail-server checks and the daily send pool; the row, the
   confirmation email and any restore happen after the reply. */

export const runtime = "nodejs"
export const maxDuration = 30

export const POST = createNewsletterPost(site)
",
  "app/api/newsletter/unsubscribe/route.ts": "import { createNewsletterUnsubscribe } from "@ogchonk/signup-kit/next"
import { site } from "@/lib/signup-config"

/* Unsubscribe link target. GET shows a page with one button and never changes anything; the button's
   POST, or a mail client's RFC 8058 one-click POST, does. */

export const runtime = "nodejs"
export const maxDuration = 30

export const { GET, POST } = createNewsletterUnsubscribe(site)
",
  "app/api/newsletter/webhook/route.ts": "import { createNewsletterWebhook } from "@ogchonk/signup-kit/next"
import { site } from "@/lib/signup-config"

/* Resend delivery events, Svix-signed. A bounced or complaining address is marked unsubscribed with
   the reason; a failed write answers 500 so Resend retries. */

export const runtime = "nodejs"
export const maxDuration = 30

export const POST = createNewsletterWebhook(site)
",
  "lib/signup-config.ts": "import { defineSite } from "@ogchonk/signup-kit/core"

/* robbychoate.com newsletter settings for the shared @ogchonk/signup-kit package. Copy lives here;
   behaviour lives in the package. No secrets in this file: they are read from the environment at
   request time. */

export const site = defineSite({
  site: "rcdot",
  kind: "newsletter",
  url: "https://robbychoate.com",
  table: "rc_subscribers",
  from: "Robby Choate <che@robbychoate.com>",
  replyTo: undefined,
  signer: "Robby Choate",
  pool: "rcdot-newsletter",
  sources: ["rcdot"],
  env: {
    resendKey: "NEWSLETTER_RESEND_API_KEY",
    tokenSecret: "NEWSLETTER_SECRET",
  },
  paths: {
    unsubscribePage: "/api/newsletter/unsubscribe",
    unsubscribeApi: "/api/newsletter/unsubscribe",
    confirmPage: "/api/newsletter/confirm",
    confirmApi: "/api/newsletter/confirm",
  },
  copy: {
    confirm: {
      subject: "Confirm your Robby Choate subscription",
      greeting: "One more step.",
      body: "Press the button to confirm you want the Robby Choate newsletter.",
      button: "Confirm",
      note: "The link works for 48 hours. If you didn't sign up, ignore this email.",
    },
    already: {
      subject: "You're already on the Robby Choate list",
      greeting: "Hello again.",
      body: "This address is already subscribed to the Robby Choate newsletter.",
      button: "Unsubscribe",
      note: "If you'd rather stop getting it, you can unsubscribe here.",
    },
    confirmPage: {
      title: "Confirm",
      heading: "Confirm your subscription",
      body: "Press the button to finish signing up.",
      button: "Confirm",
    },
    confirmed: {
      title: "Confirmed",
      heading: "You're subscribed",
      body: "Thanks. The next letter will reach this address.",
    },
    expired: {
      title: "Link expired",
      heading: "That link has expired",
      body: "Sign up again and we'll send a fresh link.",
    },
    unsubscribePage: {
      title: "Unsubscribe",
      heading: "Leave the Robby Choate list",
      body: "Press the button and we'll stop emailing this address.",
      button: "Unsubscribe",
    },
    unsubscribed: {
      title: "Unsubscribed",
      heading: "You're off the list",
      body: "We won't email this address again unless you sign up again.",
    },
    invalidLink: {
      title: "Link not valid",
      heading: "That link didn't work",
      body: "It may be incomplete. Copy the whole link from the email, or reply to our email and we'll take you off the list.",
    },
    unavailable: {
      title: "Try again later",
      heading: "Something went wrong on our side",
      body: "Try the link again in a few minutes.",
    },
  },
})
",
}
`;

