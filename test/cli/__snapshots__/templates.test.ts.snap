  site: "pf",
  kind: "waitlist",
  url: "https://passwordfreedom.co",
  table: "pf_waitlist_signups",
  from: "Password Freedom <che@passwordfreedom.co>",
  replyTo: undefined,
  signer: "Password Freedom",
  pool: "pf-waitlist",
  sources: ["hero-stripe", "closing-cta"],
  paths: {
    unsubscribePage: "/api/waitlist/unsubscribe",
    unsubscribeApi: "/api/waitlist/unsubscribe",
  },
  copy: {
    welcome: {
      subject: "You're on the Password Freedom waitlist",
      greeting: "Thanks for signing up.",
      body: "You're on the Password Freedom waitlist. We'll write again when there's news to share.",
      button: "Unsubscribe",
      note: "If you didn't sign up, or you've changed your mind, you can unsubscribe here.",
    },
    unsubscribePage: {
      title: "Unsubscribe",
      heading: "Leave the Password Freedom list",
      body: "Press the button and we'll stop emailing this address.",
      button: "Unsubscribe",
    },
    unsubscribed: {
      title: "Unsubscribed",
      heading: "You're off the list",
      body: "We won't email this address again unless you sign up again.",
    },
    invalidLink: {
      title: "Link not valid",
      heading: "That link didn't work",
      body: "It may be incomplete. Copy the whole link from the email, or reply to our email and we'll take you off the list.",
    },
    unavailable: {
      title: "Try again later",
      heading: "Something went wrong on our side",
      body: "Try the link again in a few minutes.",
    },
  },
})
",
}
`;

exports[`templates > renders plain newsletter 1`] = `
{
  ".vercelignore": "test
node_modules
",
  "api/confirm.js": "// GET shows the confirm page (changes nothing); only its button's POST confirms.
module.exports = require('@ogchonk/signup-kit/node').createNewsletterConfirmHandler(require('../signup-config'))
",
  "api/subscribe.js": "// POST /api/subscribe: the shared newsletter sign-up (double opt-in, @ogchonk/signup-kit), configured in ../signup-config.js.
module.exports = require('@ogchonk/signup-kit/node').createNewsletterHandler(require('../signup-config'))
",
  "api/unsubscribe.js": "// GET shows the unsubscribe page (changes nothing); POST unsubscribes, including RFC 8058 one-click.
module.exports = require('@ogchonk/signup-kit/node').createNewsletterUnsubscribeHandler(require('../signup-config'))
",
  "api/webhook.js": "// Resend delivery events (Svix-signed): bounced or complaining addresses are marked unsubscribed.
module.exports = require('@ogchonk/signup-kit/node').createNewsletterWebhookHandler(require('../signup-config'))
",
  "signup-config.js": "// letters.example newsletter settings for @ogchonk/signup-kit. Copy lives here; behaviour lives in the
// shared package. No secrets in this file: they are read from the environment at request time.
const { defineSite } = require('@ogchonk/signup-kit/core')

module.exports = defineSite({
  site: 'letters',
  kind: 'newsletter',
  url: 'https://letters.example',
  table: 'letters_subscribers',
  from: 'Letters <che@letters.example>',
  replyTo: undefined,
  signer: 'Letters',
  pool: 'letters-newsletter',
  sources: ['letters'],
  paths: {
    unsubscribePage: '/api/unsubscribe',
    unsubscribeApi: '/api/unsubscribe',
    confirmPage: '/api/confirm',
    confirmApi: '/api/confirm',
  },
  copy: {
    confirm: {
      subject: 'Confirm your Letters subscription',
      greeting: 'One more step.',
      body: 'Press the button to confirm you want the Letters newsletter.',
      button: 'Confirm',
      note: "The link works for 48 hours. If you didn't sign up, ignore this email.",
    },
    already: {
      subject: "You're already on the Letters list",
      greeting: 'Hello again.',
      body: 'This address is already subscribed to the Letters newsletter.',
      button: 'Unsubscribe',
      note: "If you'd rather stop getting it, you can unsubscribe here.",
    },
    confirmPage: {
      title: 'Confirm',
      heading: 'Confirm your subscription',
      body: 'Press the button to finish signing up.',
      button: 'Confirm',
    },
    confirmed: {
      title: 'Confirmed',
      heading: "You're subscribed",
      body: 'Thanks. The next letter will reach this address.',
    },
    expired: {
      title: 'Link expired',
      heading: 'That link has expired',
      body: "Sign up again and we'll send a fresh link.",
    },
    unsubscribePage: {
      title: 'Unsubscribe',
      heading: 'Leave the Letters list',
      body: "Press the button and we'll stop emailing this address.",
      button: 'Unsubscribe',
    },
    unsubscribed: {
      title: 'Unsubscribed',
      heading: "You're off the list",
      body: "We won't email this address again unless you sign up again.",
    },
    invalidLink: {
      title: 'Link not valid',
      heading: "That link didn't work",
      body: "It may be incomplete. Copy the whole link from the email, or reply to our email and we'll take you off the list.",
    },
    unavailable: {
      title: 'Try again later',
      heading: 'Something went wrong on our side',
      body: 'Try the link again in a few minutes.',
    },
  },
})
",
  "test/subscribe.test.js": "// Gate for this site's sign-up: runs the shared behaviour contract from @ogchonk/signup-kit against
// the site config, checks the handlers answer 503 (never crash) without secrets, and checks form.js
// is the installed package build. Run with: npm test
const { test } = require('node:test')
const assert = require('node:assert/strict')
const crypto = require('node:crypto')
const fs = require('node:fs')
const path = require('node:path')
const { Readable } = require('node:stream')
const { runContract, fakeStore, fakeMailer, fakeResolver, fakeEnv } = require('@ogchonk/signup-kit/testing')

const root = path.join(__dirname, '..')

async function invoke(handler, request) {
  const raw = request.body ? Buffer.from(await request.arrayBuffer()) : Buffer.alloc(0)
  const req = Readable.from(raw.length ? [raw] : [])
  req.method = request.method
  req.url = new URL(request.url).pathname + new URL(request.url).search
  req.headers = Object.fromEntries(request.headers)
  if (raw.length && !req.headers['content-length']) req.headers['content-length'] = String(raw.length)
  return new Promise((resolve) => {
    const headers = new Headers()
    const res = {
      statusCode: 200,
      headersSent: false,
      setHeader(k, v) { headers.set(k, String(v)) },
      end(b) { res.headersSent = true; resolve(new Response(b ?? null, { status: res.statusCode, headers })) },
    }
    Promise.resolve(handler(req, res)).catch((e) => resolve(new Response(String(e), { status: 599 })))
  })
}

const withoutSecrets = () => {
  for (const k of ['RESEND_API_KEY', 'SIGNUP_SECRET', 'SUPABASE_URL', 'SUPABASE_SECRET_KEY', 'SUPABASE_SERVICE_ROLE_KEY']) delete process.env[k]
}

test('the full contract holds for this site config (fake database and mail)', async () => {
  const site = require('../signup-config')
  const { createNewsletterHandler } = require('@ogchonk/signup-kit/node')
  const store = fakeStore()
  const mailer = fakeMailer()
  const pending = []
  const handler = createNewsletterHandler(site, { store, mailer, resolver: fakeResolver(['nomail.example']), env: fakeEnv({ VERCEL_ENV: 'production' }), defer: (w) => pending.push(w()) })
  const results = await runContract((r) => invoke(handler, r))
  await Promise.all(pending)
  for (const r of results) assert.ok(r.pass, \`\${r.name}: got \${r.status} \${r.body}\`)
  assert.equal(mailer.sent.length, 1, 'one confirmation for one new address')
  assert.match(mailer.sent[0].from, /<che@letters\\.example>$/)
})

test('/api/subscribe answers 503 without secrets, never a crash', async () => {
  withoutSecrets()
  const handler = require('../api/subscribe.js')
  const valid = await invoke(handler, new Request('https://letters.example/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{"email":"someone@gmail.com"}' }))
  assert.equal(valid.status, 503)
  assert.equal(await valid.text(), '{"ok":false,"error":"unavailable"}')
})

test('form.js is the installed package build, byte for byte', () => {
  const sha = (p) => crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex')
  const installed = require.resolve('@ogchonk/signup-kit/form.iife.js')
  assert.equal(sha(path.join(root, 'form.js')), sha(installed), 'run: cp node_modules/@ogchonk/signup-kit/dist/form.iife.js form.js')
})
",
  "vercel.json": "{
  "installCommand": "npm ci",
  "functions": { "api/*.js": { "maxDuration": 30 } }
}
",
}
`;

